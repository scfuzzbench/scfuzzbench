#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/scfuzzbench-user-data.log | logger -t scfuzzbench-user-data -s 2>/dev/console) 2>&1

if [[ -f /opt/scfuzzbench/.bootstrapped ]]; then
  exit 0
fi

systemctl enable --now ssh || systemctl enable --now sshd || true

mkdir -p /opt/scfuzzbench/fuzzers/${fuzzer_key}

cat <<'SHARED' >/opt/scfuzzbench/common.sh
${shared_sh}
SHARED

cat <<'SEED_CORPUS_HELPER' >/opt/scfuzzbench/prepare_seed_corpus.py
${seed_corpus_helper}
SEED_CORPUS_HELPER

cat <<'INSTALL' >/opt/scfuzzbench/fuzzers/${fuzzer_key}/install.sh
${install_sh}
INSTALL

cat <<'RUN' >/opt/scfuzzbench/fuzzers/${fuzzer_key}/run.sh
${run_sh}
RUN

cat <<'PRELIMINARY' >/opt/scfuzzbench/preliminary_snapshot.py
${preliminary_snapshot_py}
PRELIMINARY

%{ if echidna_ci_enabled ~}
cat <<'ECHIDNA_CI_EXTRACTOR' >/opt/scfuzzbench/extract_echidna_ci_artifact.py
${echidna_ci_extractor}
ECHIDNA_CI_EXTRACTOR
chmod +x /opt/scfuzzbench/extract_echidna_ci_artifact.py
%{ endif ~}

%{ if medusa_source_enabled ~}
cat <<'MEDUSA_GO_EXTRACTOR' >/opt/scfuzzbench/extract_go_toolchain.py
${medusa_go_extractor}
MEDUSA_GO_EXTRACTOR
chmod +x /opt/scfuzzbench/extract_go_toolchain.py
%{ endif ~}

cat <<'FOUNDRY_SOURCE_PATCH' >/opt/scfuzzbench/foundry-throughput-progress.patch
${foundry_source_patch}
FOUNDRY_SOURCE_PATCH

chmod +x /opt/scfuzzbench/common.sh \
  /opt/scfuzzbench/prepare_seed_corpus.py \
  /opt/scfuzzbench/preliminary_snapshot.py \
  /opt/scfuzzbench/fuzzers/${fuzzer_key}/install.sh \
  /opt/scfuzzbench/fuzzers/${fuzzer_key}/run.sh

source /opt/scfuzzbench/common.sh
install_shutdown_script
trap 'shutdown_instance' EXIT

export AWS_REGION="${aws_region}"
export AWS_DEFAULT_REGION="${aws_region}"
export SCFUZZBENCH_S3_BUCKET="${s3_bucket}"
export SCFUZZBENCH_RUN_ID="${run_id}"
export SCFUZZBENCH_RUN_STARTED_AT_EPOCH="${run_started_at_epoch}"
export SCFUZZBENCH_BENCHMARK_UUID="${benchmark_uuid}"
export SCFUZZBENCH_BENCHMARK_MANIFEST_B64="${benchmark_manifest_b64}"
export SCFUZZBENCH_TIMEOUT_SECONDS="${timeout_seconds}"
export SCFUZZBENCH_REPO_URL="${repo_url}"
export SCFUZZBENCH_COMMIT="${repo_commit}"
export SCFUZZBENCH_BENCHMARK_TYPE="${benchmark_type}"
export FOUNDRY_VERSION="${foundry_version}"
export FOUNDRY_GIT_REPO="${foundry_git_repo}"
export FOUNDRY_GIT_REF="${foundry_git_ref}"
export SCFUZZBENCH_FOUNDRY_SOURCE_PATCH="/opt/scfuzzbench/foundry-throughput-progress.patch"
export ECHIDNA_VERSION="${echidna_version}"
export ECHIDNA_CI_REPO="${echidna_ci_repo}"
export ECHIDNA_CI_RUN_ID="${echidna_ci_run_id}"
export ECHIDNA_CI_ARTIFACT_NAME="${echidna_ci_artifact_name}"
export ECHIDNA_CI_ARTIFACT_SHA256="${echidna_ci_artifact_sha256}"
export ECHIDNA_CI_COMMIT="${echidna_ci_commit}"
export ECHIDNA_CI_TOKEN_SSM_PARAMETER="${echidna_ci_token_ssm_parameter_name}"
export MEDUSA_VERSION="${medusa_version}"
export MEDUSA_GIT_REPO="${medusa_git_repo}"
export MEDUSA_GIT_REF="${medusa_git_ref}"
export MEDUSA_GIT_COMMIT="${medusa_git_commit}"
export MEDUSA_GO_VERSION="${medusa_go_version}"
export MEDUSA_GO_SHA256="${medusa_go_sha256}"
export RECON_VERSION="${recon_version}"
export SCFUZZBENCH_GIT_TOKEN_SSM_PARAMETER="${git_token_ssm_parameter_name}"
export SCFUZZBENCH_SEED_CORPUS_SOURCE="${seed_corpus_source}"
export SCFUZZBENCH_SEED_CORPUS_PROVENANCE_SOURCE="${seed_corpus_provenance_source}"
%{ for key, value in fuzzer_env ~}
export ${key}="${value}"
%{ endfor ~}
# These identity/timing values must agree with the immutable run manifest.
# Keep them authoritative even if an old request includes similarly named
# entries in its generic fuzzer environment map.
export SCFUZZBENCH_RUN_STARTED_AT_EPOCH="${run_started_at_epoch}"
export SCFUZZBENCH_FUZZER_KEY="${fuzzer_key}"
export SCFUZZBENCH_RUN_INDEX="${run_index}"
export SCFUZZBENCH_PRELIMINARY_INTERVAL_SECONDS="${preliminary_interval_seconds}"

# Upload the bootstrap (install/clone phase) log so instances that die before
# the fuzzer runner uploads its own logs are still diagnosable from S3.
upload_bootstrap_log() {
  set +e
  cache_instance_id || true
  local instance_id="$${SCFUZZBENCH_INSTANCE_ID:-unknown}"
  local prefix="${run_id}"
  if [[ -n "${benchmark_uuid}" ]]; then
    prefix="${run_id}/${benchmark_uuid}"
  fi
  aws_cli s3 cp /var/log/scfuzzbench-user-data.log \
    "s3://${s3_bucket}/logs/$${prefix}/$${instance_id}-${fuzzer_key}-bootstrap.log" \
    --no-progress || true
}
trap 'upload_bootstrap_log; shutdown_instance' EXIT

bash /opt/scfuzzbench/fuzzers/${fuzzer_key}/install.sh

# Upload the bootstrap log once right after a successful install: the EXIT-trap
# upload below can race the instance poweroff started by run.sh's own shutdown
# trap, so this is the upload guaranteed to land for instances that reach
# run.sh. Runs in a subshell so the function's set +e does not leak here.
( upload_bootstrap_log )

bash /opt/scfuzzbench/fuzzers/${fuzzer_key}/run.sh || true

touch /opt/scfuzzbench/.bootstrapped
