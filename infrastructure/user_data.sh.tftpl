#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/scfuzzbench-user-data.log | logger -t scfuzzbench-user-data -s 2>/dev/console) 2>&1

emergency_poweroff() {
  systemctl poweroff --no-block >/dev/null 2>&1 ||
    timeout 10s shutdown -h now >/dev/null 2>&1 ||
    timeout 10s halt -p >/dev/null 2>&1 ||
    true
}

# Failures before the verified framework is installed must still terminate the
# instance. The common framework replaces this with its normal upload/shutdown
# trap after it has been verified and sourced.
trap emergency_poweroff EXIT

if [[ -f /opt/scfuzzbench/.bootstrapped ]]; then
  trap - EXIT
  exit 0
fi

systemctl enable --now ssh || systemctl enable --now sshd || true

decode_b64_into() {
  local output_name=$1
  local encoded=$2
  local decoded_with_sentinel
  # The explicit subshell exit preserves base64's failure status after adding
  # the sentinel that protects trailing newlines from command substitution.
  if ! decoded_with_sentinel="$(
    set +e
    printf '%s' "$${encoded}" | base64 --decode
    status=$?
    printf '\001'
    exit "$${status}"
  )"; then
    echo "Invalid base64 bootstrap input for $${output_name}" >&2
    return 1
  fi
  decoded_with_sentinel="$${decoded_with_sentinel%$'\001'}"
  printf -v "$${output_name}" '%s' "$${decoded_with_sentinel}"
}

decode_b64_env() {
  local output_name=$1
  decode_b64_into "$${output_name}" "$2"
  export "$${output_name}"
}

decode_b64_into fuzzer_key '${fuzzer_key_b64}'
decode_b64_into bootstrap_repository '${scfuzzbench_repository_b64}'
decode_b64_into bootstrap_commit '${scfuzzbench_commit_b64}'
decode_b64_into bootstrap_manifest_sha256 '${bootstrap_manifest_sha256_b64}'
decode_b64_into bootstrap_installer_sha256 '${bootstrap_installer_sha256_b64}'

if [[ ! "$${fuzzer_key}" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
  echo "Invalid fuzzer key in bootstrap configuration" >&2
  exit 1
fi
if [[ "$${bootstrap_repository}" != "https://github.com/scfuzzbench/scfuzzbench" ]]; then
  echo "Refusing a non-canonical scfuzzbench bootstrap repository" >&2
  exit 1
fi
if [[ ! "$${bootstrap_commit}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Invalid immutable scfuzzbench bootstrap commit" >&2
  exit 1
fi
if [[ ! "$${bootstrap_manifest_sha256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "Invalid scfuzzbench bootstrap manifest digest" >&2
  exit 1
fi
if [[ ! "$${bootstrap_installer_sha256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "Invalid embedded bootstrap verifier digest" >&2
  exit 1
fi

# The configured Noble server-cloudimg family currently lists these bootstrap
# commands in its published image manifest:
# https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.manifest
# Fail closed if that moving image-family contract ever changes.
for bootstrap_command in base64 curl python3 sha256sum timeout; do
  command -v "$${bootstrap_command}" >/dev/null 2>&1
done

bootstrap_archive=$(mktemp /tmp/scfuzzbench-bootstrap.XXXXXX.tar.gz)
bootstrap_installer=$(mktemp /tmp/scfuzzbench-bootstrap.XXXXXX.py)
cleanup_bootstrap() {
  rm -f -- "$${bootstrap_archive:-}" "$${bootstrap_installer:-}"
}
trap 'cleanup_bootstrap || true; emergency_poweroff' EXIT

download_https() {
  local source_url=$1
  local destination=$2
  local max_bytes=$3
  curl \
    --fail \
    --show-error \
    --silent \
    --location \
    --proto '=https' \
    --proto-redir '=https' \
    --tlsv1.2 \
    --retry 4 \
    --retry-all-errors \
    --connect-timeout 15 \
    --max-time 300 \
    --max-filesize "$${max_bytes}" \
    --output "$${destination}" \
    "$${source_url}"
}

bootstrap_installer_url="https://raw.githubusercontent.com/scfuzzbench/scfuzzbench/$${bootstrap_commit}/infrastructure/bootstrap_bundle.py"
download_https "$${bootstrap_installer_url}" "$${bootstrap_installer}" 1048576
actual_bootstrap_installer_sha256=$(sha256sum -- "$${bootstrap_installer}" | cut -d' ' -f1)
if [[ "$${actual_bootstrap_installer_sha256}" != "$${bootstrap_installer_sha256}" ]]; then
  echo "Downloaded bootstrap verifier digest mismatch" >&2
  exit 1
fi
chmod 0700 "$${bootstrap_installer}"

bootstrap_url="https://codeload.github.com/scfuzzbench/scfuzzbench/tar.gz/$${bootstrap_commit}"
download_https "$${bootstrap_url}" "$${bootstrap_archive}" 67108864

python3 "$${bootstrap_installer}" install \
  --archive "$${bootstrap_archive}" \
  --destination /opt/scfuzzbench \
  --manifest-b64 '${bootstrap_manifest_b64}' \
  --manifest-sha256 "$${bootstrap_manifest_sha256}" \
  --repository "$${bootstrap_repository}" \
  --commit "$${bootstrap_commit}"
cleanup_bootstrap

export SCFUZZBENCH_COMMON_SH=/opt/scfuzzbench/common.sh
export SCFUZZBENCH_SAFE_PATH_OPS=/opt/scfuzzbench/safe_path_ops.py
export SCFUZZBENCH_FOUNDRY_SOURCE_PATCH=/opt/scfuzzbench/foundry-throughput-progress.patch
source "$${SCFUZZBENCH_COMMON_SH}"

decode_b64_env AWS_REGION '${aws_region_b64}'
decode_b64_env AWS_DEFAULT_REGION '${aws_region_b64}'
decode_b64_env SCFUZZBENCH_S3_BUCKET '${s3_bucket_b64}'
decode_b64_env SCFUZZBENCH_RUN_ID '${run_id_b64}'
decode_b64_env SCFUZZBENCH_RUN_STARTED_AT_EPOCH '${run_started_at_epoch_b64}'
decode_b64_env SCFUZZBENCH_BENCHMARK_UUID '${benchmark_uuid_b64}'
decode_b64_env SCFUZZBENCH_BENCHMARK_MANIFEST_B64 '${benchmark_manifest_b64_b64}'
decode_b64_env SCFUZZBENCH_TIMEOUT_SECONDS '${timeout_seconds_b64}'
decode_b64_env SCFUZZBENCH_REPO_URL '${repo_url_b64}'
decode_b64_env SCFUZZBENCH_COMMIT '${repo_commit_b64}'
decode_b64_env SCFUZZBENCH_BENCHMARK_TYPE '${benchmark_type_b64}'
decode_b64_env FOUNDRY_VERSION '${foundry_version_b64}'
decode_b64_env FOUNDRY_GIT_REPO '${foundry_git_repo_b64}'
decode_b64_env FOUNDRY_GIT_REF '${foundry_git_ref_b64}'
decode_b64_env ECHIDNA_VERSION '${echidna_version_b64}'
decode_b64_env ECHIDNA_CI_REPO '${echidna_ci_repo_b64}'
decode_b64_env ECHIDNA_CI_RUN_ID '${echidna_ci_run_id_b64}'
decode_b64_env ECHIDNA_CI_ARTIFACT_NAME '${echidna_ci_artifact_name_b64}'
decode_b64_env ECHIDNA_CI_ARTIFACT_SHA256 '${echidna_ci_artifact_sha256_b64}'
decode_b64_env ECHIDNA_CI_COMMIT '${echidna_ci_commit_b64}'
decode_b64_env ECHIDNA_CI_TOKEN_SSM_PARAMETER '${echidna_ci_token_ssm_parameter_name_b64}'
decode_b64_env MEDUSA_VERSION '${medusa_version_b64}'
decode_b64_env MEDUSA_GIT_REPO '${medusa_git_repo_b64}'
decode_b64_env MEDUSA_GIT_REF '${medusa_git_ref_b64}'
decode_b64_env MEDUSA_GIT_COMMIT '${medusa_git_commit_b64}'
decode_b64_env MEDUSA_GO_VERSION '${medusa_go_version_b64}'
decode_b64_env MEDUSA_GO_SHA256 '${medusa_go_sha256_b64}'
decode_b64_env RECON_VERSION '${recon_version_b64}'
decode_b64_env SCFUZZBENCH_GIT_TOKEN_SSM_PARAMETER '${git_token_ssm_parameter_name_b64}'
decode_b64_env SCFUZZBENCH_SEED_CORPUS_SOURCE '${seed_corpus_source_b64}'
decode_b64_env SCFUZZBENCH_SEED_CORPUS_PROVENANCE_SOURCE '${seed_corpus_provenance_source_b64}'
decode_b64_env SCFUZZBENCH_BOOTSTRAP_MANIFEST_SHA256 '${bootstrap_manifest_sha256_b64}'
%{ for key, value_b64 in fuzzer_env_b64 ~}
decode_b64_env '${key}' '${value_b64}'
%{ endfor ~}
# These identity/timing values must agree with the immutable run manifest.
# Keep them authoritative even if an old request includes similarly named
# entries in its generic fuzzer environment map.
decode_b64_env SCFUZZBENCH_RUN_STARTED_AT_EPOCH '${run_started_at_epoch_b64}'
decode_b64_env SCFUZZBENCH_FUZZER_KEY '${fuzzer_key_b64}'
decode_b64_env SCFUZZBENCH_RUN_INDEX '${run_index_b64}'
decode_b64_env SCFUZZBENCH_PRELIMINARY_INTERVAL_SECONDS '${preliminary_interval_seconds_b64}'

prepare_workspace
install_shutdown_script
trap 'shutdown_instance' EXIT
user_data_log_root=/var/log
user_data_log_root_anchor=$(realpath -e -- "$${user_data_log_root}")
user_data_log_root_identity=$(stat -Lc '%d:%i' -- "$${user_data_log_root}")

# If the AMI already has the pinned uploader's boto3 dependency, publish
# lifecycle evidence immediately. Otherwise install_base_packages starts it as
# soon as python3-boto3 is installed, before any expensive compiler/fuzzer build.
if python3 -c 'import boto3' >/dev/null 2>&1; then
  start_run_heartbeat || true
fi

# Upload the bootstrap (install/clone phase) log so instances that die before
# the fuzzer runner uploads its own logs are still diagnosable from S3.
upload_bootstrap_log() {
  set +e
  cache_instance_id || true
  local instance_id="$${SCFUZZBENCH_INSTANCE_ID:-unknown}"
  local prefix="$${SCFUZZBENCH_RUN_ID}"
  if [[ -n "$${SCFUZZBENCH_BENCHMARK_UUID}" ]]; then
    prefix="$${SCFUZZBENCH_RUN_ID}/$${SCFUZZBENCH_BENCHMARK_UUID}"
  fi
  upload_pinned_s3_file \
    /var/log/scfuzzbench-user-data.log \
    "$${user_data_log_root}" \
    "$${user_data_log_root_anchor}" \
    "$${user_data_log_root_identity}" \
    "$${SCFUZZBENCH_S3_BUCKET}" \
    "logs/$${prefix}/$${instance_id}-$${SCFUZZBENCH_FUZZER_KEY}-bootstrap.log" \
    text/plain 0 1073741824 2 2 || true
}
trap 'upload_bootstrap_log; shutdown_instance' EXIT

bash "/opt/scfuzzbench/fuzzers/$${fuzzer_key}/install.sh"

# Upload the bootstrap log once right after a successful install: the EXIT-trap
# upload below can race the instance poweroff started by run.sh's own shutdown
# trap, so this is the upload guaranteed to land for instances that reach
# run.sh. Runs in a subshell so the function's set +e does not leak here.
( upload_bootstrap_log )

bash "/opt/scfuzzbench/fuzzers/$${fuzzer_key}/run.sh" || true

printf '' |
  write_strict_descendant_file \
    /opt/scfuzzbench/.bootstrapped \
    "$${SCFUZZBENCH_ROOT}" \
    "$${SCFUZZBENCH_FRAMEWORK_ROOT_ANCHOR}" \
    "$${SCFUZZBENCH_FRAMEWORK_ROOT_IDENTITY}" 1
